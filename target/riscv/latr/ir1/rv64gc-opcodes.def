/* Pseudo-opcode produced when an instruction fetch traps. */
LATR_RV_INSN(FETCH_FAULT, fetch_fault)

/* 2.2 batch: reverse subtract and the high-half multiplies. Appended at the end
 * so existing LATR_RV_* values (and anything keyed by them) do not shift. */
LATR_RV_INSN(VRSUB_VX, vrsub_vx)
LATR_RV_INSN(VRSUB_VI, vrsub_vi)
LATR_RV_INSN(VMULH_VV, vmulh_vv)
LATR_RV_INSN(VMULH_VX, vmulh_vx)
LATR_RV_INSN(VMULHU_VV, vmulhu_vv)
LATR_RV_INSN(VMULHU_VX, vmulhu_vx)
LATR_RV_INSN(VMULHSU_VV, vmulhsu_vv)
LATR_RV_INSN(VMULHSU_VX, vmulhsu_vx)

/* 2.2 batch 2: widening add/subtract with a double-width operand (.wv/.wx). */
LATR_RV_INSN(VWADD_WV, vwadd_wv)
LATR_RV_INSN(VWADD_WX, vwadd_wx)
LATR_RV_INSN(VWADDU_WV, vwaddu_wv)
LATR_RV_INSN(VWADDU_WX, vwaddu_wx)
LATR_RV_INSN(VWSUB_WV, vwsub_wv)
LATR_RV_INSN(VWSUB_WX, vwsub_wx)
LATR_RV_INSN(VWSUBU_WV, vwsubu_wv)
LATR_RV_INSN(VWSUBU_WX, vwsubu_wx)

/* 2.2 batch 3: fixed-point signed multiply (vxrm rounding, vxsat saturation). */
LATR_RV_INSN(VSMUL_VV, vsmul_vv)
LATR_RV_INSN(VSMUL_VX, vsmul_vx)

/* 2.2 batch 4: fused multiply-add (single rounding, vv/vf). */
LATR_RV_INSN(VFMACC_VV, vfmacc_vv)
LATR_RV_INSN(VFMACC_VF, vfmacc_vf)
LATR_RV_INSN(VFNMACC_VV, vfnmacc_vv)
LATR_RV_INSN(VFNMACC_VF, vfnmacc_vf)
LATR_RV_INSN(VFMSAC_VV, vfmsac_vv)
LATR_RV_INSN(VFMSAC_VF, vfmsac_vf)
LATR_RV_INSN(VFNMSC_VV, vfnmsac_vv)
LATR_RV_INSN(VFNMSC_VF, vfnmsac_vf)
LATR_RV_INSN(VFMADD_VV, vfmadd_vv)
LATR_RV_INSN(VFMADD_VF, vfmadd_vf)
LATR_RV_INSN(VFNMADD_VV, vfnmadd_vv)
LATR_RV_INSN(VFNMADD_VF, vfnmadd_vf)
LATR_RV_INSN(VFMSUB_VV, vfmsub_vv)
LATR_RV_INSN(VFMSUB_VF, vfmsub_vf)
LATR_RV_INSN(VFNMSSUB_VV, vfnmsub_vv)
LATR_RV_INSN(VFNMSSUB_VF, vfnmsub_vf)

/* 2.2 batch 5: widening fused multiply-add (SEW inputs, 2*SEW accumulator). */
LATR_RV_INSN(VFWMACC_VV, vfwmacc_vv)
LATR_RV_INSN(VFWMACC_VF, vfwmacc_vf)
LATR_RV_INSN(VFWNMACC_VV, vfwnmacc_vv)
LATR_RV_INSN(VFWNMACC_VF, vfwnmacc_vf)
LATR_RV_INSN(VFWMSAC_VV, vfwmsac_vv)
LATR_RV_INSN(VFWMSAC_VF, vfwmsac_vf)
LATR_RV_INSN(VFWNMSAC_VV, vfwnmsac_vv)
LATR_RV_INSN(VFWNMSAC_VF, vfwnmsac_vf)
